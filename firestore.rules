rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/employees/$(request.auth.uid));
    }

    function isAdmin() {
      return isAuthenticated() && (
          (request.auth.token.email == "jenamorado@tentelcom.com") ||
          (getUserData() != null && 'role' in getUserData().data && (
              getUserData().data.role == "admin" || 
              getUserData().data.role == "administrador" ||
              getUserData().data.role == "administración" ||
              getUserData().data.role == "administracion" ||
              getUserData().data.role == "rrhh"
          ))
      );
    }

    function hasPermission(path) {
      return isAuthenticated() && 
        'permissions' in getUserData().data && 
        getUserData().data.permissions is map && 
        (
          isAdmin() ||
          (path in getUserData().data.permissions && getUserData().data.permissions[path] == true) ||
          (path in getUserData().data.permissions && getUserData().data.permissions[path] is map)
        );
    }

    function hasNestedPermission(module, submodule) {
      let dotKey = module + "." + submodule;
      return isAuthenticated() && 
        'permissions' in getUserData().data && 
        getUserData().data.permissions is map && 
        (
          isAdmin() ||
          (dotKey in getUserData().data.permissions && getUserData().data.permissions[dotKey] == true) ||
          (module in getUserData().data.permissions && getUserData().data.permissions[module] == true) ||
          (
            module in getUserData().data.permissions && 
            getUserData().data.permissions[module] is map && 
            submodule in getUserData().data.permissions[module] && 
            getUserData().data.permissions[module][submodule] == true
          )
        );
    }

    function isSupervisor() {
      return isAuthenticated() && 
        'role' in getUserData().data && 
        getUserData().data.role != null && 
        (
          getUserData().data.role == "supervisor" ||
          getUserData().data.role == "Supervisor" ||
          getUserData().data.role == "SUPERVISOR"
        );
    }

    function isAdjustmentField(data) {
      return (data.extraHours != null && data.extraHours != 0) || 
             (data.bonuses != null && data.bonuses != 0) || 
             (data.advancePayment != null && data.advancePayment != 0) || 
             (data.travelExpenses != null && data.travelExpenses != 0) || 
             (data.availabilityBonus != null && data.availabilityBonus != 0);
    }

    // EMPLOYEES
    match /employees/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
      
      match /work_history/{historyId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }
      
      match /admin_log/{logId} {
        allow read, write: if isAdmin();
      }
      
      match /employee_files/{fileId} {
        allow read: if isAdmin();
        allow write: if isAdmin();
      }
    }

    // CLIENTS
    match /clients/{id} {
      allow read: if isAuthenticated();
      allow write: if hasPermission("cotizaciones") || hasPermission("gestion_proyectos") || hasNestedPermission("gestion_proyectos", "crear") || hasNestedPermission("gestion_proyectos", "editar");
    }

    // COTIZACIONES
    match /quotes/{id} {
      allow read: if hasPermission("cotizaciones") || hasPermission("pre_analysis") || hasPermission("gestion_proyectos") || hasNestedPermission("gestion_proyectos", "crear") || hasNestedPermission("gestion_proyectos", "editar");
      allow write: if hasPermission("cotizaciones") || hasPermission("pre_analysis");
    }

    // CATÁLOGO EXTERNO
    match /external_products/{id} {
      allow read, write: if hasPermission("external_products");
    }

    // TRABAJOS
    match /trabajos/{id} {
      allow read, write: if hasPermission("trabajos");
      
      match /timeline/{commentId} {
        allow read, write: if hasPermission("trabajos");
      }
    }

    // COUNTERS (PARA OT CODES, SOLICITUDES, CLIENTES, ETC.)
    match /counters/{id} {
      allow read, write: if isAuthenticated();
    }

    // JOB TYPES
    match /job_types/{id} {
      allow read: if isAuthenticated();
      allow write: if hasPermission("trabajos");
    }

    // LOGS DE REPORTES DE MATERIALES
    match /material_reports_log/{id} {
      allow read, write: if hasNestedPermission("inventario", "solicitudes") || hasNestedPermission("inventario", "movimientos") || hasNestedPermission("inventario", "reportes") || hasPermission("trabajos") || isAdmin();
    }

    // INVENTARIO
    match /inventory/{id} {
      allow read: if hasNestedPermission("inventario", "general") || hasNestedPermission("inventario", "solicitudes") || hasNestedPermission("inventario", "movimientos") || hasNestedPermission("inventario", "bodegas_vehiculares") || hasNestedPermission("inventario", "herramientas_asignadas") || hasNestedPermission("inventario", "reportes") || hasPermission("trabajos") || isAdmin();
      allow write: if hasNestedPermission("inventario", "general") || isAdmin();
    }
    match /inventory_items/{id} {
      allow read: if hasNestedPermission("inventario", "general") || hasNestedPermission("inventario", "solicitudes") || hasNestedPermission("inventario", "movimientos") || hasNestedPermission("inventario", "bodegas_vehiculares") || hasNestedPermission("inventario", "herramientas_asignadas") || hasNestedPermission("inventario", "reportes") || hasPermission("trabajos") || isAdmin();
      allow update: if hasNestedPermission("inventario", "general") || hasNestedPermission("inventario", "movimientos") || hasNestedPermission("inventario", "bodegas_vehiculares") || hasNestedPermission("inventario", "herramientas_asignadas") || hasPermission("trabajos") || (hasNestedPermission("inventario", "solicitudes") && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reserved']) || request.resource.data.diff(resource.data).affectedKeys().hasAny(['stock']))) || isAdmin();
      allow create, delete: if hasNestedPermission("inventario", "general") || isAdmin();
    }
    match /inventory_movements/{id} {
      allow read: if hasNestedPermission("inventario", "movimientos") || hasNestedPermission("inventario", "solicitudes") || hasNestedPermission("inventario", "bodegas_vehiculares") || hasNestedPermission("inventario", "herramientas_asignadas") || hasPermission("trabajos") || isAdmin();
      allow write: if hasNestedPermission("inventario", "movimientos") || hasNestedPermission("inventario", "solicitudes") || hasNestedPermission("inventario", "bodegas_vehiculares") || hasNestedPermission("inventario", "herramientas_asignadas") || hasPermission("trabajos") || isAdmin();
    }
    match /tool_assignments/{id} {
      allow read: if hasNestedPermission("inventario", "herramientas_asignadas") || hasNestedPermission("inventario", "general") || hasPermission("trabajos") || isAdmin();
      allow write: if hasNestedPermission("inventario", "herramientas_asignadas") || hasNestedPermission("inventario", "general") || isAdmin();
    }
    match /material_reports/{id} {
      allow read: if hasNestedPermission("inventario", "solicitudes") || hasNestedPermission("inventario", "movimientos") || hasNestedPermission("inventario", "bodegas_vehiculares") || hasNestedPermission("inventario", "reportes") || hasPermission("trabajos") || isAdmin();
      allow create: if (hasNestedPermission("inventario", "solicitudes") || hasNestedPermission("inventario", "bodegas_vehiculares") || hasPermission("trabajos") || isAdmin()) && (isAdmin() || !('status' in request.resource.data) || !(request.resource.data.status in ['Aprobada', 'Rechazada']));
      allow delete: if hasNestedPermission("inventario", "solicitudes") || hasNestedPermission("inventario", "bodegas_vehiculares") || hasPermission("trabajos") || isAdmin();
      allow update: if isAdmin() || (
        (hasNestedPermission("inventario", "movimientos") && (!('status' in request.resource.data) || request.resource.data.status in ['Despachada', 'Parcial'] || request.resource.data.status == resource.data.status)) ||
        ((hasNestedPermission("inventario", "solicitudes") || hasNestedPermission("inventario", "bodegas_vehiculares") || hasPermission("trabajos")) && (!('status' in request.resource.data) || !(request.resource.data.status in ['Aprobada', 'Rechazada'])))
      );
    }
    match /materialRequests/{id} {
      allow read: if hasNestedPermission("inventario", "solicitudes") || hasNestedPermission("inventario", "movimientos") || hasNestedPermission("inventario", "bodegas_vehiculares") || hasNestedPermission("inventario", "reportes") || hasPermission("trabajos") || isAdmin();
      allow create: if (hasNestedPermission("inventario", "solicitudes") || hasNestedPermission("inventario", "bodegas_vehiculares") || hasPermission("trabajos") || isAdmin()) && (isAdmin() || !('status' in request.resource.data) || !(request.resource.data.status in ['Aprobada', 'Rechazada']));
      allow delete: if hasNestedPermission("inventario", "solicitudes") || hasNestedPermission("inventario", "bodegas_vehiculares") || hasPermission("trabajos") || isAdmin();
      allow update: if isAdmin() || (
        (hasNestedPermission("inventario", "movimientos") && (!('status' in request.resource.data) || request.resource.data.status in ['Despachada', 'Parcial'] || request.resource.data.status == resource.data.status)) ||
        ((hasNestedPermission("inventario", "solicitudes") || hasNestedPermission("inventario", "bodegas_vehiculares") || hasPermission("trabajos")) && (!('status' in request.resource.data) || !(request.resource.data.status in ['Aprobada', 'Rechazada'])))
      );
    }
    match /material_dispatches/{id} {
      allow read, write: if hasNestedPermission("inventario", "solicitudes") || hasNestedPermission("inventario", "movimientos") || hasNestedPermission("inventario", "bodegas_vehiculares") || hasPermission("trabajos") || isAdmin();
    }
    match /dispatch_responsibles/{id} {
      allow read, write: if isAuthenticated();
    }

    function isVehicleDeleteAuthorized() {
      return isAuthenticated() && request.auth.token.email == "jenamorado@tentelcom.com";
    }

    // BODEGAS VEHICULARES
    match /vehicle_warehouse_items/{id} {
      allow read, create, update: if hasNestedPermission("inventario", "bodegas_vehiculares") || hasNestedPermission("inventario", "solicitudes") || hasNestedPermission("inventario", "movimientos") || hasPermission("trabajos") || isAdmin();
      allow delete: if isVehicleDeleteAuthorized();
    }
    match /vehicle_movements/{id} {
      allow read, create, update: if hasNestedPermission("inventario", "bodegas_vehiculares") || hasNestedPermission("inventario", "solicitudes") || hasNestedPermission("inventario", "movimientos") || hasPermission("trabajos") || isAdmin();
      allow delete: if isVehicleDeleteAuthorized();
    }
    match /vehicle_material_requests/{id} {
      allow read, create, update: if hasNestedPermission("inventario", "bodegas_vehiculares") || hasNestedPermission("inventario", "solicitudes") || hasPermission("trabajos") || isAdmin();
      allow delete: if isVehicleDeleteAuthorized();
    }
    match /vehicle_requests/{id} {
      allow read, create, update: if hasNestedPermission("inventario", "bodegas_vehiculares") || hasNestedPermission("inventario", "solicitudes") || hasPermission("trabajos") || isAdmin();
      allow delete: if isVehicleDeleteAuthorized();
    }
    match /vehicle_consumptions/{id} {
      allow read, create, update: if hasNestedPermission("inventario", "bodegas_vehiculares") || hasNestedPermission("inventario", "solicitudes") || hasPermission("trabajos") || isAdmin();
      allow delete: if isVehicleDeleteAuthorized();
    }

    // PROYECTOS
    match /projects/{id} {
      allow read: if isAuthenticated();
      allow create: if hasNestedPermission("gestion_proyectos", "crear") || isAdmin();
      allow update: if hasNestedPermission("gestion_proyectos", "editar") || isAdmin();
      allow delete: if hasNestedPermission("gestion_proyectos", "eliminar") || isAdmin();
    }

    // FINANZAS
    match /invoices/{id} {
      allow read, write: if hasNestedPermission("finanzas", "movimientos");
    }
    match /cashflow_entries/{id} {
      allow read, write: if hasNestedPermission("finanzas", "movimientos");
    }
    match /absence_records/{id} {
      allow read, write: if hasNestedPermission("finanzas", "ausencias");
    }
    match /pay_stubs/{id} {
      allow read: if hasNestedPermission("finanzas", "comprobantes") || (isAuthenticated() && resource.data.employeeEmail == request.auth.token.email);
      allow create, update: if (hasNestedPermission("finanzas", "comprobantes") || isSupervisor()) && (!isAdjustmentField(request.resource.data) || isAdmin());
      allow delete: if isAdmin();
    }
    match /automatic_adjustments/{id} {
      allow read, write: if hasNestedPermission("finanzas", "comprobantes");
    }
    match /purchase_orders/{id} {
      allow read, write: if hasNestedPermission("finanzas", "ordenes_compra");
    }

    match /bitacora_vehiculos/{id} {
      allow read: if hasNestedPermission("bitacoraVehiculos", "registros") || hasNestedPermission("bitacoraVehiculos", "analisis") || hasPermission("trabajos") || (resource != null && resource.data.createdBy == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        hasNestedPermission("bitacoraVehiculos", "registros") || 
        hasPermission("trabajos") ||
        isAdmin() || 
        (resource != null && resource.data.createdBy == request.auth.uid) ||
        request.resource.data.updatedBy == request.auth.uid
      );
      allow delete: if hasNestedPermission("bitacoraVehiculos", "registros") || isAdmin();
      
      match /timeline/{commentId} {
        allow read, write: if isAuthenticated();
      }
    }

    match /vehicle_expenses/{id} {
      allow read: if hasNestedPermission("bitacoraVehiculos", "analisis") || isAdmin();
      allow write: if hasNestedPermission("bitacoraVehiculos", "analisis") || isAdmin();
    }

    // OPERATIONAL TIMELINES
    match /operational_timelines/{timelineId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
      
      match /events/{eventId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if hasNestedPermission("bitacoraVehiculos", "registros") || hasPermission("trabajos");
      }
    }

    match /vehiculos/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // NOTIFICATIONS
    match /notifications/{id} {
      allow read: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.targetUserId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create: if isAuthenticated();
    }

    // METADATA (e.g. counters)
    match /metadata/{id} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ANALÍTICA
    match /analytics_events/{id} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated();
    }

    // TEST CONNECTION
    match /test/{id} {
      allow read: if isAuthenticated();
    }

    // AUDIT LOG
    match /audit_log/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
      allow delete: if false;
    }

    // SYSTEM ACCESS LOGS
    match /system_access_logs/{id} {
      allow create: if isAuthenticated();
      allow read: if isAdmin();
    }

    // ACCESO ADMIN POR DEFECTO A COLECCIONES GENERALES
    match /{document=**} {
      allow read, create, update: if isAdmin();
      allow delete: if request.auth.token.email == "jenamorado@tentelcom.com";
    }
  }
}

