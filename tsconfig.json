{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "./*.ts",
    "./*.tsx",
    "auth",
    "components",
    "contexts",
    "core",
    "data",
    "design-system",
    "firebase",
    "hooks",
    "modules",
    "repositories",
    "services",
    "types",
    "utils",
    "tests"
  ],
  "exclude": [
    "node_modules",
    "functions",
    "dist",
    "vite.config.ts"
  ]
}